# ==============================================================================
# TBX FinOps Assistant - Environment Configuration
# ==============================================================================

# Database Configuration (PostgreSQL)
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=finops
POSTGRES_USER=finops
POSTGRES_PASSWORD=finops
# Set to require for managed providers (e.g. Neon). Leave disable for local Docker Postgres.
POSTGRES_SSLMODE=disable

# Google MCP Toolbox Endpoint (Docker service name inside compose)
MCP_TOOLBOX_URL=http://mcp-toolbox:5000
# Bearer token required by the MCP Toolbox when deployed with auth enabled (e.g. Cloud Run). Leave blank locally.
MCP_AUTH_TOKEN=

# AI Provider Configuration
# Set to 'groq' to use Groq LLM API with high-speed tool calling
# Set to 'openrouter' to enable OpenRouter API (Claude, Llama, DeepSeek, GPT, etc.)
# Set to 'sarvam' to enable Sarvam LLM with OpenAI-compatible tool calling
AI_PROVIDER=openrouter

# OpenRouter AI API Configuration (Leave blank to skip)
OPENROUTER_API_KEY=sk-or-v1-your_openrouter_key_here
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=liquid/lfm-2.5-2.6b:free

# Sarvam AI API Configuration (Leave blank to skip)
SARVAM_API_KEY=sk_your_sarvam_key_here
SARVAM_BASE_URL=https://api.sarvam.ai/v1
SARVAM_MODEL=sarvam-105b
SARVAM_STT_URL=https://api.sarvam.ai/speech-to-text
SARVAM_STT_MODEL=saaras:v3

# Cross-Origin Resource Sharing (Allowed Frontend Origin)
FRONTEND_URL=http://localhost:3000

# Frontend Backend API Target
NEXT_PUBLIC_API_URL=http://localhost:8080

# ==============================================================================
# OpenTelemetry & Langfuse Observability  (OPTIONAL)
# ==============================================================================
# Langfuse tracing is optional and safe to skip:
#  - With Docker Compose, the 'langfuse' profile auto-activates when
#    LANGFUSE_PUBLIC_KEY below is set to a real value (leave empty to disable).
#  - For local dev, run with: SPRING_PROFILES_ACTIVE=langfuse mvn spring-boot:run
# The backend works normally either way.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
# Base64 encoded: echo -n "public_key:secret_key" | base64  → required only when profile is active
LANGFUSE_AUTH_HEADER=
LANGFUSE_BASE_URL=https://cloud.langfuse.com
OTEL_EXPORTER_OTLP_ENDPOINT=https://cloud.langfuse.com/api/public/otel


